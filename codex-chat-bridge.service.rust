[Unit]
Description=Codex Chat Bridge (Rust)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/codex-chat-bridge-rs
EnvironmentFile=/opt/codex-chat-bridge/secrets.env
Environment=BRIDGE_HOST=0.0.0.0
Environment=BRIDGE_PORT=18090
ExecStart=/opt/codex-chat-bridge-rs/bin/codex-chat-bridge
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
